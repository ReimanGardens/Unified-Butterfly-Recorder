# Copy this file to .env.local and fill in the values. .env.local is gitignored.
#
# Every REACT_APP_* value is compiled into the public JS bundle, so never put a
# server-side secret here. See "Configuration" in README.md.

# AWS Cognito user pool used for sign-in (identifiers, not secrets)
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_Iy8VQOdMl
REACT_APP_COGNITO_CLIENT_ID=3rtdm404l6ibhk1t3nenh6a7l0

# Backend API Gateway endpoints
REACT_APP_SURVEY_API_URL=https://aodue3pi7b.execute-api.us-east-1.amazonaws.com/prod/ubr_survey
REACT_APP_LIST_API_URL=https://fxktw1f1z7.execute-api.us-east-1.amazonaws.com/prod/managedList

# Google Maps JavaScript API + Static Maps API (restrict by HTTP referrer in Google Cloud console)
REACT_APP_GOOGLE_MAPS_API_KEY=

# OpenWeather current-weather API
REACT_APP_OPENWEATHER_API_KEY=
